{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "firstblick": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "index": "src/index.html",
            "styles": ["src/styles.css"],
            "assets": [{"glob":"**/*","input":"public"}],
            "outputPath": "dist/firstblick"
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json",
              "budgets": [
                {"type":"initial","maximumWarning":"650kB","maximumError":"900kB"},
                {"type":"anyComponentStyle","maximumWarning":"12kB","maximumError":"20kB"}
              ]
            },
            "development": {"optimization":false,"sourceMap":true,"extractLicenses":false}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {"proxyConfig":"proxy.conf.json"},
          "configurations": {
            "production": {"buildTarget":"firstblick:build:production"},
            "development": {"buildTarget":"firstblick:build:development"}
          },
          "defaultConfiguration":"development"
        }
      }
    }
  }
}
